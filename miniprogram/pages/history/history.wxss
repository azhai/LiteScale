.chip-row {
  white-space: nowrap;
  display: flex;
  padding: 16rpx 24rpx 0;
}

.chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #fff;
  color: #6b6b6b;
}

.chip-on {
  background: #6a4c93;
  color: #fff;
}

.range {
  display: flex;
  padding: 20rpx 24rpx 0;
}

.range-item {
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #fff;
  color: #6b6b6b;
}

.range-item-on {
  background: #6a4c93;
  color: #fff;
}

.chart {
  width: 100%;
  height: 220px;
}

.legend {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.legend-line {
  display: inline-block;
  width: 24rpx;
  height: 4rpx;
  margin: 0 8rpx 0 16rpx;
}

.legend-line.main {
  background: #6a4c93;
}

.legend-line.avg {
  background: #e58f2a;
}

.legend-text {
  font-size: 22rpx;
  color: #6b6b6b;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 50%;
  padding: 10rpx 0;
}

.cell-label {
  display: block;
  font-size: 24rpx;
  color: #8a8a8a;
}

.cell-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #6a4c93;
}

.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-weight {
  font-size: 30rpx;
  font-weight: 600;
}

.row-sub {
  font-size: 22rpx;
  color: #9a9aa5;
}

.row-delta {
  font-size: 26rpx;
  margin-right: 20rpx;
}

.row-delta.down { color: #1b7f3a; }
.row-delta.up { color: #d1495b; }

.row-more {
  font-size: 32rpx;
  color: #b0b0b0;
  padding: 0 12rpx;
}
